    public class Bed {
    private int bedNumber;
    private boolean occupied;
    private Patient patient;

    public Bed(int bedNumber) {
        this.bedNumber = bedNumber;
        this.occupied = false;
        this.patient = null;
    }

    public int getBedNumber() {
        return bedNumber;
    }

    public boolean isOccupied() {
        return occupied;
    }

    public Patient getPatient() {
        return patient;
    }

    public void allocate(Patient patient) {
        this.patient = patient;
        this.occupied = true;
    }

    public void release() {
        this.patient = null;
        this.occupied = false;
    }

    @Override
    public String toString() {
        if (occupied) {
            return "Bed " + bedNumber + " - Occupied by " +
                   patient.getFirstName() + " " + patient.getLastName() +
                   " (" + patient.getPatientId() + ")";
        }

        return "Bed " + bedNumber + " - Available";
    }
}
import java.util.ArrayList;
import java.util.List;

public class HospitalSystem {

    private final List<Patient> patients;
    private final List<Bed> beds;

    public HospitalSystem() {
        patients = new ArrayList<>();
        beds = new ArrayList<>();

        // Create 20 hospital beds
        for (int i = 1; i <= 20; i++) {
            beds.add(new Bed(i));
        }
    }

    public boolean addPatient(Patient patient) {
        if (findPatient(patient.getPatientId()) != null) {
            return false;
        }

        patients.add(patient);
        return true;
    }

    public Patient findPatient(String patientId) {
        for (Patient patient : patients) {
            if (patient.getPatientId().equalsIgnoreCase(patientId)) {
                return patient;
            }
        }

        return null;
    }

    public boolean removePatient(String patientId) {
        Patient patient = findPatient(patientId);

        if (patient == null) {
            return false;
        }

        // Release any bed occupied by this patient
        for (Bed bed : beds) {
            if (bed.isOccupied() &&
                bed.getPatient().getPatientId().equalsIgnoreCase(patientId)) {
                bed.release();
            }
        }

        patients.remove(patient);
        return true;
    }

    public List<Patient> getPatients() {
        return patients;
    }

    public List<Bed> getBeds() {
        return beds;
    }

    public boolean allocateBed(String patientId) {
        Patient patient = findPatient(patientId);

        if (patient == null) {
            return false;
        }

        // Check whether patient already has a bed
        for (Bed bed : beds) {
            if (bed.isOccupied() &&
                bed.getPatient().getPatientId().equalsIgnoreCase(patientId)) {
                return false;
            }
        }

        // Find first available bed
        for (Bed bed : beds) {
            if (!bed.isOccupied()) {
                bed.allocate(patient);
                return true;
            }
        }

        return false;
    }

    public boolean releaseBed(int bedNumber) {
        for (Bed bed : beds) {
            if (bed.getBedNumber() == bedNumber) {
                if (!bed.isOccupied()) {
                    return false;
                }

                bed.release();
                return true;
            }
        }

        return false;
    }

    public Bed findBedByPatient(String patientId) {
        for (Bed bed : beds) {
            if (bed.isOccupied() &&
                bed.getPatient().getPatientId().equalsIgnoreCase(patientId)) {
                return bed;
            }
        }

        return null;
    }

    public int getAvailableBedCount() {
        int count = 0;

        for (Bed bed : beds) {
            if (!bed.isOccupied()) {
                count++;
            }
        }

        return count;
    }

    public int getOccupiedBedCount() {
        return beds.size() - getAvailableBedCount();
    }

    public void displayPatients() {
        if (patients.isEmpty()) {
            System.out.println("No patients registered.");
            return;
        }

        for (Patient patient : patients) {
            System.out.println("----------------------------");
            System.out.println(patient);

            Bed bed = findBedByPatient(patient.getPatientId());

            if (bed != null) {
                System.out.println("Bed Number: " + bed.getBedNumber());
            } else {
                System.out.println("Bed Number: Not allocated");
            }
        }
    }

    public void displayBeds() {
        for (Bed bed : beds) {
            System.out.println(bed);
        }
    }

    public void generateReport() {
        System.out.println("\n========== WARD REPORT ==========");
        System.out.println("Total beds: " + beds.size());
        System.out.println("Occupied beds: " + getOccupiedBedCount());
        System.out.println("Available beds: " + getAvailableBedCount());
        System.out.println("Registered patients: " + patients.size());

        System.out.println("\n----- Patient List -----");

        for (Patient patient : patients) {
            Bed bed = findBedByPatient(patient.getPatientId());

            String bedInfo = bed == null
                    ? "No bed"
                    : "Bed " + bed.getBedNumber();

            System.out.println(
                    patient.getPatientId() + " - " +
                    patient.getFirstName() + " " +
                    patient.getLastName() +
                    " - " + patient.getPatientCategory() +
                    " - " + bedInfo
            );
        }

        System.out.println("=================================\n");
    }
}